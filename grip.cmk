#!/usr/bin/env -S ./compose.mk cmk compile
# grip.cmk: serve a github-styled render of README.md via grip, in a container.
#
# cmk_pragma ::: { "kind": "plugin" } :::
#
#   docs.grip / docs.grip.serve serves README.md (or docs.grip.serve/<file>) on
#   GRIP_PORT (default 6419).  A library (no __main__), loaded via the root
#   Makefile plugin list.

# `Dockerfile` is a cmk KIND (inline image + build/dispatch scaffolding).
from cmk import Dockerfile

export GRIP_PORT?=6419
Dockerfile grip(bases=lifecycle.container, docker_args="-p ${GRIP_PORT}:${GRIP_PORT}")(|
  FROM python:3.11-bookworm
  RUN pip3 install --break-system-packages grip==4.6.2
  ENTRYPOINT grip
|)

docs.grip.serve/%:
	${make} grip.serve/${*}

docs.grip.%:; ${make} grip.${*}

docs.grip: grip.serve

grip.serve/%:
	grip(${*} 0.0.0.0:${GRIP_PORT})

# the blocking verb is a member of the lifecycle mixin, so the rule below only adds a guard
grip.__serve__ = ${make} grip.serve/README.md

grip.serve: assert.file/README.md
