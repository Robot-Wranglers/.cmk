#!/usr/bin/env -S ./compose.mk cmk compile
# cmk_pragma ::: { "kind": "module", "target_locals": true } :::

'''
agents: a message-passing stack layered over the core Actor transport.

Three classes, each detailed at its own docstring: SocketActor puts the
transport over a unix socket, Agent folds a mailbox and store onto the
inproc transport, and jqd combines them into a socketed agent whose
default handler is a jq fold.  A subclass overrides a verb by plain
target (leftmost-base MRO).

Library only: this module declares no instances, so importing it costs
nothing but the classes.  See demos/cmk/jqd.cmk for the worked example.
'''
import log
import jb, flux
# bind the class declaration keyword and the base Actor transport bare
from cmk import class
from cmk import Actor

# a safety cap on the SocketActor serve loop; a caller that stops serve
# explicitly once its casts have drained never waits this out.
CMK_ACTOR_TTL ?= 30

class agents.SocketActor(bases=Actor)[|
  '''
  Socket transport: an out-of-process mailbox over a unix socket.  One
  serve loop consumes concurrent casters in arrival order, so no lock is
  needed.  Each verb's own docstring covers its mechanics.
  '''
  self.deliver:
    '''Connect and send one message, retrying while the listener starts'''
    sock <- ${self}.get_sock()
    msg=`cat`
    cmk.flux.retry(printf '%s\n' "$$msg" | socat - UNIX-CONNECT:"$$sock" 2>/dev/null)

  self.serve.fg:
    '''Run the socket listen loop (fg); one consumer serializes casters'''
    sock <- ${self}.get_sock()
    rm -f -- "$$sock" "$${sock}.fifo"; mkfifo "$${sock}.fifo"; \
    ${self}.log(serving on ${cyan}$$sock${no_ansi_dim} ttl=${CMK_ACTOR_TTL}s ${sep} single-consumer); \
    timeout --foreground ${CMK_ACTOR_TTL} \
      socat UNIX-LISTEN:"$$sock",fork STDOUT 2>/dev/null > "$${sock}.fifo" & \
    echo $$! > "$${sock}.pid"; \
    while IFS= read -r env; do [ -z "$$env" ] && continue; """$$env""" | ${self}.recv(); done < "$${sock}.fifo"; \
    rm -f -- "$${sock}.fifo" "$${sock}.pid"; \
    ${self}.log(closed)

  self.serve: flux.bg/self.serve.fg
    '''Serve backgrounded so casters proceed concurrently; fg = serve.fg'''

  self.serve.stop:
    '''End the listener and settle while the queue drains: the parent dies
    but its forked relays finish their writes, and the wait is sized for
    one slow recv per queued message.'''
    sock <- ${self}.get_sock()
    p=`cat "$${sock}.pid" 2>/dev/null`; [ -n "$$p" ] && kill "$$p" 2>/dev/null || true
    cmk.flux.retry([ ! -e "$${sock}.fifo" ], 600)
|]

class agents.Agent(bases=Actor)[|
  '''
  The default agent: an inproc transport with a mailbox (a channel) and
  store folded in -- the casual, socket-free choice.  A message is a
  dual-plane envelope: goals (native cmk targets, run receiver-side) and
  data (folded through a per-instance transform into the mailbox).  Resets
  the logger to the plain Loggable default (dropping the Actor prefix), a
  re-specialization it must state itself since it is-a Actor.  Each verb's
  own docstring covers its mechanics.
  '''
  # construct the mailbox and register teardown at exit (the channel
  # self-purges; this adds the socket unlink).  stop is idempotent, so
  # an early opt-in call stays safe when the exit run repeats it.
  ${self}.__minted__ = cmk.channel(${self}.mbox)$(call __cmk_post__.append,${self}.stop)
  self._envelope = ${jq.run} -cn --arg g "$${goals:-}" --arg d "$${body:-}" '{goals:$$g,data:$$d}'
  ${self}.log.__call__ = cmk.log(${self} ${sep} ${__args__})

  self.cast:
    '''Frame a data message from stdin and hand it to the transport'''
    body <- ${stream.stdin.maybe}
    env <- ${self}._envelope()
    """$$env""" | ${self}.deliver()

  self.send:
    '''Frame a control message from stdin and hand it to the transport'''
    goals <- ${stream.stdin}
    env <- ${self}._envelope()
    """$$env""" | ${self}.deliver()

  self.recv:
    '''Dispatch one message off the wire (goals run; data folds in)'''
    env <- ${stream.stdin}
    goals <- """$$env""" | ${jq.run} -r '.goals // ""'
    payload <- """$$env""" | ${jq.run} -r '.data // ""'
    xform <- this.mk.def.read/self 2>/dev/null
    [ -n "$$xform" ] || xform='.'
    if [ -n "$$goals" ]; then \
      printf '%s\n' "$$goals" | this.mk.kernel.each{CMK_EVENT=$$payload}; \
    else \
      obj=`"""$$payload""" | ${jq.run} -c . 2>/dev/null` || obj=`"""$$payload""" | ${jq.run} -Rc 'split(" ")|map(split("=")|{(.[0]):(.[1:]|join("="))})|add'`; \
      n=`${make} ${self}.mbox.count`; \
      printf '%s' "$$obj" | ${jq.run} -c "$${xform:-.}" | ${jq.run} -c --argjson s "$$((n+1))" '.seq=$$s' | $(${self}.mbox.push); \
    fi

  self.stop:
    '''Tear down: end serve, drop the mailbox, free the socket (at exit)'''
    sock <- ${self}.get_sock()
    p=`cat "$${sock}.pid" 2>/dev/null`; [ -n "$$p" ] && kill "$$p" 2>/dev/null || true
    ${make} ${self}.mbox.purge
    rm -f -- "$$sock" "$${sock}.pid" "$${sock}.fifo" $(call flux.bg.pidfile,${self}.serve.fg)
|]

class agents.Jsonrpc[|
  '''
  Envelope v2: the wire is one JSON-RPC 2.0 object with flat addressing
  extensions (to, reply_to) that conformant peers ignore.  Casts are
  notifications: cmk.push carries the data plane, cmk.run the goals plane.
  recv dispatches by method; any non-cmk method runs as a target with the
  full request as the event, so ask handlers can answer by id.
  '''
  self._envelope = ${jq.run} -cn --arg g "$${goals:-}" --arg d "$${body:-}" 'if $$g != "" then {jsonrpc:"2.0",method:"cmk.run",params:{goals:$$g}} else {jsonrpc:"2.0",method:"cmk.push",params:$$d} end'

  self.recv:
    '''Dispatch one v2 message (push folds into the mailbox; methods run)'''
    env <- ${stream.stdin}
    method <- """$$env""" | ${jq.run} -r '.method // ""'
    if [ "$$method" = "cmk.push" ]; then \
      xform=`this.mk.def.read/self 2>/dev/null`; \
      [ -n "$$xform" ] || xform='.'; \
      obj=`"""$$env""" | ${jq.run} -c '.params | if type=="string" then (fromjson? // {raw:.}) else . end'`; \
      n=`${make} ${self}.mbox.count`; \
      """$$obj""" | ${jq.run} -c "$$xform" | ${jq.run} -c --argjson s "$$((n+1))" '.seq=$$s' | $(${self}.mbox.push); \
    else \
      case "$$method" in \
        cmk.run) goals=`"""$$env""" | ${jq.run} -r '.params.goals // ""'`;; \
        *) goals="$$method";; \
      esac; \
      printf '%s\n' "$$goals" | this.mk.kernel.each{CMK_EVENT=$$env}; \
    fi
|]

class agents.Askable[|
  '''
  The reply plane as a mixin, envelope-level only: ask/<method> casts a
  request carrying a correlation id and a reply address (a program-declared
  replies actor with a source-pinned mailbox), then polls the reply mailbox
  for the correlated result.  Any transport whose deliver works gains ask.
  '''
  self.ask/%:
    '''One round-trip: stdin is the argument, stdout the correlated result'''
    arg=`${stream.stdin.maybe}`
    corr="c$$$$"
    req=`${jq.run} -cn --arg m "${*}" --arg c "$$corr" --arg a "$$arg" '{jsonrpc:"2.0",method:$$m,id:$$c,reply_to:"replies",params:{arg:$$a}}'`
    """$$req""" | ${self}.deliver()
    cmk.flux.retry(${make} reply.ready/$$corr 2>/dev/null, 600)
    ${make} replies.mbox.filter/id,$$corr | ${jq.run} -r '.[0].result'
|]

reply.ready/%:
  '''True once the reply mailbox holds a Response with the given id'''
  ${make} replies.mbox.filter/id,${*} | ${jq.run} -e 'length>0' >/dev/null 2>&1

class agents.jqd(bases=agents.SocketActor,agents.Agent,Materializable)[|
  '''
  jqd: a socketed agent whose default handler is a jq fold -- is-a agent
  (mailbox + store) over a SocketActor transport.  SocketActor is first, so
  its deliver/serve win the MRO over agent's inproc Actor.  The block
  body `jqd NAME(| <jq> |)` lifts to a `define NAME`, resolved per message
  by the socket loop (a plain agent's body is its handlers).
  Materializable carries the raw-body trait, so an instance body stays a
  jq payload (its .shape) rather than being evaluated as a class body.
  '''
|]
