#!/usr/bin/env -S ./compose.mk cmk compile
# cmk_pragma ::: { "kind": "module" } :::

'''
dsl.python: inline Python as a first-class dsl -- an interpreted body that runs
in a container (IMG_PYTHON via python3) mixed with the Language protocol
(structural reflection over the `.py` comby grammar).  Sibling of dsl.golang.
Import it and write `python NAME(| ...python... |)`.
'''

from cmk import dsl

# comby patterns for the `python` grammar family, consumed by the Language protocol
# (compose.mk lang.parser) when an instance sets __grammar__=python.  Python is
# indentation-based, so the def-header line stands in for the brace-family patterns.
lang.parser.pat.symbols.python=def :[[name]](:[args]):
lang.parser.pat.blocks.python=def :[[name]](:[args]):

# IMG_PYTHON (env) overrides the interpreter image; resolve it before the ctor so
# the machine-backing kwarg is a plain string (a shell `$${VAR:-x}` would warn).
_img.python=$(call m5|,IMG_PYTHON,python:3.12-slim)

# python: interpreted dsl; runs bodies in a python container, reflects via comby.
# __lang__ is the comby matcher; __grammar__ selects the Python pattern family.
dsl python(img=${_img.python} entrypoint=python3 ifaces=Language classvars='__lang__=.py')[|
  self.__grammar__ = python
|]
