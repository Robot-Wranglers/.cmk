#!/usr/bin/env -S ./compose.mk cmk compile

# cmk_pragma ::: { "kind": "module" } :::

# multi.cmk: multimethod dispatch, promoted from demos/cmk/experimental/multimethod.cmk.

'''
A multimethod is a named operation whose cases live in separate compilation units,
so a plugin adds a case by defining a variable and the operation never learns its
name.  A namespace redeclare unions members across files, the registry half; this
module adds dispatch, a call site picking a member by a key.  Declare an instance
of an axis kind, then invoke it.  The retrofit surface at the end gives an existing
name a method table without editing the file that owns it.
'''

from cmk import class
from cmk import namespace

# The contract: an axis names a method table and maps a key into it; the default refuses.
cmk.protocol Dispatchable(abstract=__resolve__:methods)(|
  ''' The dispatch capability: name a method table, and map a key to one of its methods. '''
  self.__nostrategy__ = $(call log.module.fail, self declares no resolution strategy, CMK_NO_DISPATCH)
  self.__resolve__ = $(self.__nostrategy__)
  self.methods = $(self.__nostrategy__)
|)

# The registry half is inherited from namespace; this adds resolution over it.
cmk.class multi(bases=cmk.namespace,Dispatchable)(|
  '''
  Supplies the default resolution strategy, where the method table is the instance's own
  members and a key names one of them, falling back to a member named default.  Dispatching
  by explicit key is the primitive; supplying a key from instance state is the axis job.
  Resolution returns a method name, never a value, so a method is free to be a macro or a
  published target.  Every dispatch traces itself; an axis names its condition via __cond__.
  '''
  # A namespace body is data, not a template: without this the class path evaluates it once at top level.
  ${self}.__raw_body__ := 1
  ${self}.__resolve__ =$(if $(filter $(strip ${__args__}),$(${self}.methods)),${self}.$(strip ${__args__}),$(if $(filter default,$(${self}.methods)),${self}.default,))
  ${self}.__axisvars__ =
  ${self}.methods = $(filter-out $(${self}.__axisvars__),$(${self}.__all__))
  ${self}.__nokey__ = $(call log.module.fail, self declares no key source, CMK_NO_KEY)
  ${self}.__dispatch__ = $(${self}.__nokey__)
  ${self}.__nomatch__ = $(call log.module.fail, no method for key $(strip ${__args__}), CMK_NO_METHOD)
  ${self}.__apply__ = $(if $(strip ${__args__}),$(call $(strip ${__args__})),$(call ${self}.__nomatch__,$(strip ${2})))
  ${self}.__cond__ = $(strip ${__args__})
  ${self}.__choice__ = $(patsubst ${self}.%,%,$(call ${self}.__resolve__,${__args__}))
  ${self}.__trace__ = $(call log.part1, ${self} dispatching on $(call ${self}.__cond__,${__args__})) ; $(call log.part2, $(call ${self}.__choice__,${__args__}))
  ${self}.dispatch.key = ${self}.__trace__(${__args__}) ; ${self}.__apply__(${self}.__resolve__(${__args__}),${__args__})
  ${self}.dispatch = ${self}.dispatch.key($(${self}.__dispatch__))
  ${self}.__call__ = $(${self}.dispatch)
|)

# An axis subkind: the key is the value of the environment variable named by var.
cmk.class multi.env(bases=multi)(|
  ''' Dispatch on an environment variable, named per instance by the var keyword. '''
  ${self}.__axis__ = env
  ${self}.__axisvars__ = var
  ${self}.__dispatch__ = $($(${self}.var))
  ${self}.__cond__ = $(${self}.var)=$(${self}.__dispatch__)
|)

# An open axis: the key names a foreign namespace that implements a shared operation.
cmk.class multi.kind(bases=multi)(|
  '''
  Dispatch on a kind name, resolving to that kind's implementation of the operation named
  by the op keyword.  The table is discovered rather than declared, so a contributor joins
  it by defining that operation and never names the multimethod.
  '''
  ${self}.__axis__ = kind
  ${self}.__axisvars__ = op
  ${self}.__op__ = $(${self}.op)
  ${self}.__cond__ = kind=$(strip ${__args__})
  ${self}.methods = $(sort $(patsubst %.$(${self}.__op__),%,$(filter %.$(${self}.__op__),$(.VARIABLES))))
  ${self}.__resolve__ = $(if $(filter $(strip ${__args__}),$(${self}.methods)),$(strip ${__args__}).$(${self}.__op__),$(if $(filter default,$(${self}.__all__)),${self}.default,))
|)

# A runtime axis: the key is decided by the shell, so dispatch re-enters make with it.
cmk.class multi.stream(bases=multi)(|
  '''
  Dispatch on the shape of stdin, tested when the recipe runs rather than at expansion.
  The key cannot exist before the recipe runs, so this axis probes and re-enters make,
  costing a sub-make per dispatch.
  '''
  ${self}.__axis__ = stream
  ${self}.__cond__ = stdin
  ${self}.__probe__ = ${io.tty.stdin} && echo tty || echo pipe
  ${self}/%:; ${self}.dispatch.key(${*})
  ${self}.dispatch = ${make} ${self}/`$(${self}.__probe__)`
|)

# Retrofit: give an existing name a method table without editing the file that owns it.

# Eligibility: with no macro of that name there is nothing to rebind.
retrofit.twinned? = cmk.m5.defined?($(strip m5[1]))

# Macro existence is cheap and not decisive; the delegation shape is a lint's job.
retrofit.assert = $(if cmk.retrofit.twinned?(m5[1]),,cmk.log.module.fail($(strip m5[1]) has no macro body to freeze so a rebind would have nothing to delegate to; most often a target name that was never twinned, CMK_NOT_TWINNED))

# The declaration: refuse an ineligible name, then freeze the current body under its prev slot.
retrofit = cmk.retrofit.assert(m5[1])cmk.m5.def!($(strip m5[1]).__prev__,$(value $(strip m5[1])))

# The receiver is computed, so resolution and application stay explicit calls.
retrofit.dispatch = $(call $(call $(strip m5[1]).__resolve__,$(strip m5[2])),m5[3])

# The same, taking the key from the multimethod's own axis rather than the caller.
retrofit.via = cmk.retrofit.dispatch(m5[1],$($(strip m5[1]).__dispatch__),m5[2])
