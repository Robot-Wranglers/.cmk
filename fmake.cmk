 /* Whether or not .NOTINTERMEDIATE with no prerequisites was given.  */
 unsigned int no_intermediates;
 
+/* Nonzero in a resident dispatch child, which shares state with its parent.  */
+unsigned int fmake_child;
+
+/* Socket named by --serve, parked on once the makefiles are read.  */
+static const char *fmake_serve_path;
+
+/* The zygote's own argv, whose options a request may repeat and have dropped.  */
+static int fmake_serve_argc;
+static char **fmake_serve_argv;
+
