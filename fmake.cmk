 static void clean_jobserver (int status);
+static void fmake_serve (const char *sockpath,
+                         struct goaldep *deps) NORETURN;
+static void fmake_client (const char *sockpath, int argc,
+                          char **argv) NORETURN;
+static int fmake_resident (int argc, char **argv);
 static void print_data_base (void);
