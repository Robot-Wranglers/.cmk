#!/usr/bin/env -S ./compose.mk cmk compile
# virtual-machine.cmk: the control-stack and __vm__ CEK machine, a module.
#
# cmk_pragma ::: { "kind": "module" } :::
#
# Docs: https://robot-wranglers.github.io/compose.mk/plugins/cmk-virtual-machine
#
## The goals after the current target are the continuation, what is left to
## do.  `__vm__` exposes it as a small CEK machine bound to the live make
## process: C the current goal, E an environment, K a tree of saved frames.
## It binds the source-agnostic `control_stack` to the supervisor, so every
## transfer re-dispatches flat and a jump-loop runs at constant depth.  Use
## the operators inline in a recipe, where `${@}` is the current target.
##
## The machine reads its own state and rewrites its own future:
##
## | operator | cell | effect |
## | --- | --- | --- |
## | peek, rest, depth | C read | inspect the pending goals: top, below-top, count |
## | vm.push | C xfer | run a goal next, then resume the continuation, with an implicit return |
## | vm.drop | C xfer | skip the next pending goal |
## | vm.goto | C xfer | tail-jump to a goal, keeping the goals after it |
## | vm.replace | C xfer | replace the whole continuation |
## | getenv, setenv | E | read or bind one env key |
## | current_frame, caller_frame | E/K read | the live or caller frame, both folded into the snapshot |
## | vm.call, vm.return | K xfer | call saves a frame and jumps; return pops it and resumes |
## | vm.yield, also vm.ctx.send | K xfer | bind a value as yielded in the caller env, then return |
## | vm.ctx.receive | E receive | re-hydrate the context into the shell at a goal's entry |
## | vm.fork | K | record a branching frame and run the branches as a pipeline |
## | backtrace | K read | print the control tree: saved frames plus the live continuation |
## | snapshot, also snap | C/E/K read | the whole self-model as one JSON object, the dashboard source |
## | stack, also kontinuation | K read | the saved frames |
## | ip, also instruction_pointer, control | C read | the innermost goal |
##
## Opt-in reflective E via `vm.reflect` (`prefix=P` to allowlist a prefix, or
## `exclude=<names>` for env minus a parse-time baseline) makes E mirror the
## live shell env: an exported var is snapshotted at each transfer and
## re-hydrated by `vm.ctx.receive`, auto-injected into every recipe by the
## compiler or by `@vm.ctx.hydrate` in plain make.  Dormant until declared.
##
## Every transfer needs the supervisor, whose trampoline re-dispatches flat.
##
## Import it as a module: `import virtual-machine.cmk as vm, flat=1`, or name
## operators with `from virtual-machine import vm.goto, __vm__`.  It lands
## flat, so its operators keep the names written here, and it needs compose.mk
## loaded first.  Worked examples: the demos/cmk/vm-*.cmk family.

# The control-stack algebra: an inlined module, with names written out in full.
control_stack[|
  # Inspect filters over a continuation on stdin, one goal per line, top first.
  control_stack.top=head -1
  control_stack.below=tail -n +2
  control_stack.size=grep -c .

  # Keep the goals after the marker's first occurrence; empty when absent.
  control_stack.after=awk -v g='$(strip ${1})' 'f{print} $$0==g{f=1}'

  ## Frames are a run-shared stack of JSON objects, stored opaquely with the
  ## shape left to consumers, so the machine can layer a CEK closure on top.
  ## Push reads a frame on stdin, pop emits and removes the top, peek emits it
  ## without removing, and frames is the whole stack oldest first.  A frame may
  ## carry frame-lists, making the stack a tree, which is how fork reflects.
  cmk.io.stack!(CONTROL_STACK_FRAMES)

  vm.sweep:
    rm -f -- \
      .tmp.cmk.vmenv.$${MAKE_SUPER} \
      .tmp.cmk.vmcaller.$${MAKE_SUPER} \
      .tmp.CONTROL_STACK_FRAMES.$${MAKE_SUPER} \
      .tmp.cmk.vmlvl.$${MAKE_SUPER}.* 2>/dev/null || true

  # Run-scoped teardown of the vm temp set, through the at-exit idiom.
  cmk.__cmk_post__.append(vm.sweep)

  control_stack.frames=cmk.io.stack(${CONTROL_STACK_FRAMES})
  control_stack.frame.push={ \
  	{ [ -z "$${CMK_SUPER_RESUME:-}" ] || printf "%s\n" __vm__.backtrack.next > "$${CMK_SUPER_RESUME}" ; } ; \
  	cmk.io.stack.push(${CONTROL_STACK_FRAMES}) ; \
  	}
  control_stack.frame.pop=cmk.io.stack.__next__(${CONTROL_STACK_FRAMES})
  control_stack.frame.peek=( jqp='.[-1] // {}' ; cmk.io.stack.get.run(${CONTROL_STACK_FRAMES}) )
|]

# Realize the control stack over the live make process, reusing the filters.
cmk.import.module(def=control_stack flat=1 preprocs=stream.echo)

## ░░ Ambient isolation ░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░
## An ambient runs a goal in a fresh VM namespace keyed on <key>, the
## substrate under fork and reflect-fork.  Without a supervisor it has no
## teardown: frame, env, and value files outlive the join, to harvest and sweep.
_vm.ambient=MAKE_SUPER="$(strip ${1})" CONTROL_STACK_FRAMES=".tmp.CONTROL_STACK_FRAMES.$(strip ${1})" CMK_IO_STACK=".tmp.cmk.stack.$(strip ${1})" CMK_SUPERVISOR=0 CMK_INTERNAL=1

# The files an ambient re-keys, one leaf per VM concern, swept as a set.
_vm.ambient.leaves=CONTROL_STACK_FRAMES cmk.vmenv cmk.vmcaller cmk.vmlvl cmk.brf cmk.stack mk.super cmk.vmlast cmk.vmstep cmk.vmframe cmk.vmcmd

# Destroy-companion of an ambient: sweeps every <key-glob> leaf in one pass.
_vm.ambient.sweep=for _vl in ${_vm.ambient.leaves}; \
	do rm -f -- ".tmp.$${_vl}."$(strip ${1}) 2>/dev/null || true; \
	done

# Read C: goals pending after this target, top first, minus flags and hooks.
__vm__.read=echo "$${MAKE_CLI}" \
	| tr ' ' '\n' \
	| grep -avE '^(flux\.(pre|post)/|mk\.super\.enter/)?$$' \
	| awk -v t='${@}' 'f{print} $$0==t{f=1}'

# Inspect C by composing the read with the generic filters, inline in a recipe.
__vm__.peek=${__vm__.read} | ${control_stack.top}
__vm__.rest=${__vm__.read} | ${control_stack.below} | ${stream.nl.to.space}
__vm__.depth=${__vm__.read} | ${control_stack.size}

## ░░ Transfer ░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░
## Each verb recomputes the goal list into the shell var `cont`, then hands
## off to the supervisor trampoline.  Empty `cont` transfers to nothing, so a
## guard that skips the assignment terminates cleanly.  The hand-off stays an
## indirection: inlining the trampoline into a macro mangles it when nested.
vm.fire=$(call mk.super.tramp, $${cont})

# C-transfer ops; the capture prefix is empty unless reflective env is on.
vm.push=${__vm__.env.capture}cont="$(strip ${1}) `${__vm__.read} | ${stream.nl.to.space}`" && ${vm.fire}
vm.drop=${__vm__.env.capture}cont="`${__vm__.read} | ${control_stack.below} | ${stream.nl.to.space}`" && ${vm.fire}
vm.goto=${__vm__.env.capture}cont="$(strip ${1}) `${__vm__.read} | $(call control_stack.after,${1}) | ${stream.nl.to.space}`" && ${vm.fire}
vm.replace=${__vm__.env.capture}cont="${1}" && ${vm.fire}

## ░░ Environment (E) ░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░
## Scope bindings as run-shared JSON, made on first setenv.  Tail transfers
## thread it, call frames it, return restores it: E is a scope, not a global.
__vm__.env.file=$(call m5|,CMK_VMENV,.tmp.cmk.vmenv.$${MAKE_SUPER})

# Provenance: a capture stamps the sending goal, so a receiver names its source.
__vm__.env.caller.file=.tmp.cmk.vmcaller.$${MAKE_SUPER}
__caller__=$$(cat ${__vm__.env.caller.file} 2>/dev/null)

__vm__.env.read=$(if ${__vm__.env.declared},\
	( ( [ -s ${__vm__.env.file} ] && cat ${__vm__.env.file} || echo '{}' ) ; ${__vm__.env.live} ) | ${jq.run.pipe} -s -c 'add',\
	( [ -s ${__vm__.env.file} ] && cat ${__vm__.env.file} || echo '{}' ))
__vm__.env.write=cat > ${__vm__.env.file}.tmp && mv -f ${__vm__.env.file}.tmp ${__vm__.env.file}

## ░░ Reflective env ░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░
## Opt in with vm.reflect.  Once a capture policy is declared, tail transfers
## snapshot a subset of the live shell env into E and env reads merge it
## back, so an exported var needs no setenv.  Otherwise env.read and the
## capture prefix collapse to non-reflective forms, creating nothing.
## Capture is host-side and pipes into jq, so jq may be dockerized.
__vm__.env.prefix?=
__vm__.env.exclude?=
__vm__.env.base?=
__vm__.env.declared=$(or ${__vm__.env.prefix},${__vm__.env.exclude})
__vm__.env.capture=$(if ${__vm__.env.declared},( ${__vm__.env.read} | ${__vm__.env.write} ) && printf '%s' "${@}" > ${__vm__.env.caller.file} && ,)

# Parse stdin key=value lines into one JSON object, split on the first sign.
__vm__.env.tojson=split("\n")|map(select(length>0))|map((index("=")) as $$i|{(.[:$$i]):.[$$i+1:]})|add // {}

# The live program-env subset as JSON, per the declared policy.
__vm__.env.live.prefix=env \
	| grep "^${__vm__.env.prefix}" \
	| ${jq.run.pipe} -R -s '${__vm__.env.tojson}'
__vm__.env.live.exclude=env \
	| grep -E '^[A-Za-z_][A-Za-z0-9_]*=' \
	| grep -vE "^(${__vm__.env.exclude})" \
	| awk -F= -v base="${__vm__.env.base}" 'BEGIN{n=split(base,a," ");for(i=1;i<=n;i++)b[a[i]]} !($$1 in b)' \
	| ${jq.run.pipe} -R -s '${__vm__.env.tojson}'
__vm__.env.live=$(if ${__vm__.env.prefix},${__vm__.env.live.prefix},${__vm__.env.live.exclude})
# Receive side: emit E as export lines, guarded so an empty E spawns no jq.
vm.ctx.receive=[ -s ${__vm__.env.file} ] \
  && { __ctx="$$( ${__vm__.env.read} )" ; \
       __names="$$( printf '%s' "$$__ctx" | ${jq.run} -r 'keys | join(" ")' 2>/dev/null )" ; \
       __from="${__caller__}" ; \
       [ -z "$$__names" ] || { $(call log.part1, ${yellow}receiving context from ${bold}$$__from${no_ansi}) ; $(call log.part2, ${dim}$$__names${no_ansi}) ; } ; \
       printf '%s' "$$__ctx" | ${jq.run} -r 'to_entries[] | "export \(.key)=\(.value|@sh)"' ; } \
  || true
# The decorator evals what receive emits, so bindings read as plain shell vars.
vm.ctx.hydrate=eval "$$(${vm.ctx.receive})"

## ░░ Compile stage ░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░
## A stage owned by this plugin, not core.  A compiler_post pragma makes core
## lift this define and run it at the tail of the stage chain, so core
## hard-codes no VM concept.  It splices the hydrate call in as the first
## command of every recipe-bearing target, skipping infra and prereq-only
## names; by then indentation is normalized and the splice lands in the shell.
define _cmk_blk_vm_hydrate
  BEGIN { depth = 0; have = 0
    CALL = "$(call vm.ctx.hydrate)"
    SKIP = "^([._]|__vm__[.]|mk[.]|flux[.]|io[.]|tux[.]|cmk[.]|polyglot[.])" }
  # a define the compiler folded onto one physical line is a whole body, not a target head
  /define .*endef/ { print; next }
  /^define / { depth++; print; next }
  /^endef[ \t]*$/ { if (depth > 0) depth--; print; next }
  depth > 0 { print; next }
  # a held target takes the splice only once a real recipe line follows it
  have { have = 0
    if ($0 !~ /^\t/) { print held; print; next }
    print held; pend = 1 }
  # the docstring stays adjacent to its target, so the splice waits for the first command
  pend && /^\t@#/ { print; next }
  pend && /^\t/ { pend = 0; print "\t" CALL; print; next }
  pend { pend = 0 }
  /^[^\t#][^=]*:([^=]|$)/ {
    name = $0; sub(/:.*/, "", name); sub(/[ \t].*/, "", name)
    if (name ~ SKIP) { print; next }
    # a recipe prefix has to stay leftmost, so the splice goes after it rather than before
    if ($0 ~ /;[ \t]*[^ \t;]/) { i = index($0, ";")
      lhs = substr($0, 1, i); body = substr($0, i + 1); pfx = ""
      if (match(body, /^[ \t]*[-@+]+/)) { pfx = substr(body, RSTART, RLENGTH); body = substr(body, RSTART + RLENGTH) }
      print lhs pfx " " CALL " && " body; next }
    held = $0; have = 1; next }
  { print }
  END { if (have) { print held } }
endef

# Capture policy: prefix allowlists, exclude is env minus a parse-time baseline.
define _vm.reflect.exclude
__vm__.env.exclude:=$(strip $(subst ${space},|,$(patsubst exclude=%,%,$(strip ${1}))))
__vm__.env.base:=$(shell env | grep -E '^[A-Za-z_][A-Za-z0-9_]*=' | sed 's/=.*//' | LC_ALL=C sort | tr '\n' ' ')
endef
vm.reflect=$(if $(findstring prefix=,${1}),\
	cmk.m5!(__vm__.env.prefix:=$(strip $(patsubst prefix=%,%,$(strip ${1})))),\
	cmk.m5!(cmk._vm.reflect.exclude(${1})))

# Frame accessors: current_frame is the live state, caller_frame the top K frame.
__vm__.current_frame.environment=${__vm__.env.read}
__vm__.current_frame=${__vm__.env.read} \
	| ${jq.run} -c --arg g "${@}" --arg c "`${__vm__.rest}`" '{goal:$$g,cont:$$c,env:.}'
__vm__.caller_frame=${control_stack.frame.peek}
__vm__.caller_frame.environment=${__vm__.caller_frame} | ${jq.run} -c '.env // {}'

__vm__.getenv=${__vm__.env.read} \
	| ${jq.run} -r --arg k "$(strip ${1})" '.[$$k] // empty'
__vm__.setenv=${__vm__.env.read} \
	| ${jq.run} -c --arg k "$(strip ${1})" --arg v "$(strip ${2})" '.[$$k]=$$v' \
	| ${__vm__.env.write}

## ░░ Call, return, yield, fork ░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░
## The K-frame verbs.  Each assigns `cont` before anything else, so the
## guarded idiom stays safe: an untaken branch leaves `cont` empty and stops.
vm.call=cont="$(strip ${1})" \
	&& fr="$$( ${__vm__.env.read} \
		| ${jq.run} -c --arg g "$(strip ${1})" --arg c "$$( ${__vm__.read} | ${stream.nl.to.space} )" '{goal:$$g,cont:$$c,env:.}' )" \
	&& printf '%s' "$$fr" | ${control_stack.frame.push} \
	&& ${vm.fire}
# Only a call frame is kindless: a kinded top means return eats a choice point.
vm.return=top="$$( ${control_stack.frame.peek} || echo null )" \
	&& kind="$$( printf '%s' "$$top" | ${jq.run} -r '.kind // empty' 2>/dev/null )" \
	&& { test -z "$$kind" \
		|| { $(call log, ${red}✗ vm.return ${sep} ${dim}top frame is a $${kind} point${no_ansi}) ; exit 1 ; } ; } \
	&& fr="$$( ${control_stack.frame.pop} || echo null )" \
	&& printf '%s' "$$fr" | ${jq.run} -c '.env // {}' | ${__vm__.env.write} \
	&& cont="$$( printf '%s' "$$fr" | ${jq.run} -r '.cont // empty' )" \
	&& ${vm.fire}

# The generator transition, unlike the process-level yield; ctx.send aliases it.
vm.yield=fr="$$( ${control_stack.frame.pop} || echo null )" \
	&& fr="$$( printf '%s' "$$fr" | ${jq.run} -c --arg v "$(strip ${1})" '.env.yielded=$$v' )" \
	&& printf '%s' "$$fr" | ${jq.run} -c '.env // {}' | ${__vm__.env.write} \
	&& cont="$$( printf '%s' "$$fr" | ${jq.run} -r '.cont // empty' )" \
	&& ${vm.fire}
vm.ctx.send=${vm.yield}

# Fork frames for reflection only; branches run on the pipeline, not the vm.
vm.fork=br="$(strip ${1})" \
	&& fr="$$( printf '%s\n' $$br \
		| ${jq.run} -R . \
		| ${jq.run} -sc --arg g "$$br" '{goal:($$g|gsub(" ";",")),kind:"fork",branches:.}' )" \
	&& printf '%s' "$$fr" | ${control_stack.frame.push} \
	&& ( ${make} flux.pipeline/$$( echo $$br | tr ' ' ',' ) ; \
		rc=$$? ; \
		${control_stack.frame.pop} >/dev/null 2>&1 ; \
		exit $$rc )

## ░░ Choice and backtracking ░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░
## Choose is fork made sequential: it records untried alternatives in a
## choice frame, runs the first branch, and keeps the rest on K.  A failure
## unwinds here and takes the next alternative: depth-first backtracking.
## Branches arrive space-separated as one argument and dispatch alone; the
## frame continuation runs on exhaustion, its env snapshot is the trail.
vm.choose=${__vm__.env.capture}set -- $(strip ${1}) \
	&& _first="$$1" \
	&& shift \
	&& _alts="$$*" \
	&& fr="$$( ${__vm__.env.read} \
		| ${jq.run} -c --arg c "$$( ${__vm__.read} | ${stream.nl.to.space} )" --arg a "$$_alts" '{cont:$$c,env:.,kind:"choice",alts:($$a|split(" ")|map(select(length>0)))}' )" \
	&& printf '%s' "$$fr" | ${control_stack.frame.push} \
	&& cont="$$_first" \
	&& ${vm.fire}
## Pop K to the nearest choice frame with an untried alternative, restore its
## env as the trail undo, consume one alternative, push the frame back with
## the rest, and print the goals to run next.  Empty output means the search
## is exhausted.  Frames above the choice point are discarded: their branch
## failed.  Single source of truth for the verb below and the safety-net.
__vm__.backtrack.next:
	${__vm__.backtrack.compute}
## One jq pass over the stack file yields three lines: the stack after pop and
## re-push, the frame's env or null when exhausted, and the alternative or the
## last choice frame's continuation.  The stack is rewritten whole.
__vm__.backtrack.jq=. as $$s \
	| ([range(($$s|length)-1; -1; -1) | select($$s[.] | (.kind=="choice") and ((.alts|length)>0))] | first) as $$i \
	| if $$i == null then [], null, ([$$s[] | select(.kind=="choice") | .cont // ""] | first // "") \
	  else ($$s[$$i]) as $$f | ($$s[:$$i] + [$$f | .alts |= .[1:]]), ($$f.env // {}), $$f.alts[0] end
__vm__.backtrack.compute=_f=$(call io.stack.cur,${CONTROL_STACK_FRAMES}) ; [ -s "$$_f" ] || echo '[]' > "$$_f" ; \
	{ IFS= read -r _stk ; IFS= read -r _env ; IFS= read -r _out ; } <<< "$$( ${jq.run} -c -r '${__vm__.backtrack.jq}' "$$_f" )" ; \
	_stmp=$$(mktemp "$$_f.tmp.XXXXXX") && printf '%s\n' "$$_stk" > "$$_stmp" && mv "$$_stmp" "$$_f" ; \
	[ "$$_env" = null ] || { printf '%s' "$$_env" | ${__vm__.env.write} ; \
	  { [ -z "$${CMK_SUPER_RESUME:-}" ] || printf "%s\n" __vm__.backtrack.next > "$${CMK_SUPER_RESUME}" ; } ; } ; \
	printf '%s' "$$_out"
# Synchronous unwind: take the next alternative, else log and fall through.
vm.backtrack=cont="$$( ${make} __vm__.backtrack.next 2>/dev/null )" ; \
	case "$$cont" in *[![:space:]]*) ${vm.fire} ;; \
	  *) $(call log, ${yellow}✗ search exhausted ${sep} ${dim}no more alternatives) ; true ;; esac

# The control-stack tree, outermost frame first, then the live continuation.
__vm__.backtrace:
	@# Render the full control stack: saved frames (with kind/goal and any fork branches)
	@# followed by this level's pending continuation.
	echo "== vm backtrace =="
	${control_stack.frames} \
		| ${jq.run} -r 'to_entries[] | "  [\(.key)] \(.value.kind // "call") \(.value.goal)" + ((.value.branches // []) | if length>0 then " {"+join(",")+"}" else "" end)' 2>/dev/null \
		|| true
	printf '  ...live: [%s]\n' "`${__vm__.rest}`"

## ░░ Level ledger ░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░
## Captures process nesting that explicit K frames miss: one file per live
## make level, keyed by the supervisor.  The pre-hook records the goal
## entering a level and the post-hook clears it, so the files present are the
## live cross-level callstack.  Gated on this plugin being imported, so other
## programs pay nothing; a recursive make bypassing the hooks goes unseen.
__vm__.level.file=.tmp.cmk.vmlvl.$${MAKE_SUPER}.$${MAKELEVEL:-0}
__vm__.level.record=${jq.run} -nc \
		--argjson lvl "$${MAKELEVEL:-0}" \
		--arg g "$(strip ${1})" \
		--arg c "$$( ${__vm__.read} | ${stream.nl.to.space} )" \
		'{lvl:$$lvl,goal:$$g,cont:$$c}' > ${__vm__.level.file}.tmp 2>/dev/null \
	&& mv -f ${__vm__.level.file}.tmp ${__vm__.level.file} 2>/dev/null \
	|| true
__vm__.level.clear=rm -f ${__vm__.level.file} 2>/dev/null || true

## ░░ Real frames ░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░
## A per-recipe-shell call stack, injected as each recipe's first line under
## the trace pragma, so it catches recursion the level ledger misses.  Entry
## writes a file keyed by supervisor, level, and process id, so parallel
## workers at one level cannot collide; an exit trap records the finished
## frame and removes the live file.  The deepest live file is the pointer.
__vm__.frame.file=.tmp.cmk.vmframe.$${MAKE_SUPER}.$${MAKELEVEL:-0}.$$$$
__vm__.frame.cmd.file=.tmp.cmk.vmcmd.$${MAKE_SUPER}.$${MAKELEVEL:-0}.$$$$
__vm__.frame.step.file=.tmp.cmk.vmstep.$${MAKE_SUPER}
__vm__.frame.last.file=.tmp.cmk.vmlast.$${MAKE_SUPER}
# Frame vars are set before the locals baseline, so they stay out of the delta.
__vm__.frame.enter=_vmgoal="$@" ; \
	_vmstep=$$(( $$(cat ${__vm__.frame.step.file} 2>/dev/null || echo 0) + 1 )) ; \
	echo "$$_vmstep" > ${__vm__.frame.step.file} 2>/dev/null || true ; \
	${jq.run} -nc \
		--arg g "$$_vmgoal" \
		--argjson s "$$_vmstep" \
		--argjson l "$${MAKELEVEL:-0}" \
		--argjson p "$$$$" \
		'{step:$$s,goal:$$g,lvl:$$l,pid:$$p}' > ${__vm__.frame.file} 2>/dev/null || true ; \
	_target_local_baseline="$$(compgen -v 2>/dev/null)" ; \
	__vmframe(){ \
		_cmk_l_rc=$$? ; \
		set +e +o pipefail ; \
		_vmloc="$$(${__locals__} 2>/dev/null)" ; \
		case "$$_vmloc" in [\{]*) : ;; *) _vmloc='{}' ;; esac ; \
		_vmkeys="$$(printf '%s' "$$_vmloc" | ${jq.run} -c 'keys' 2>/dev/null)" ; \
		case "$$_vmkeys" in [\[]*) : ;; *) _vmkeys='[]' ;; esac ; \
		_vmcmdj="$$(head -c 240 ${__vm__.frame.cmd.file} 2>/dev/null | ${jq.run} -Rs . 2>/dev/null)" ; \
		case "$$_vmcmdj" in \"*) : ;; *) _vmcmdj='""' ;; esac ; \
		printf '{"step":%s,"goal":"%s","rc":%s,"locals":%s,"cmd":%s}' \
			"$$_vmstep" "$$_vmgoal" "$${_cmk_l_rc:-0}" "$$_vmkeys" "$$_vmcmdj" > ${__vm__.frame.last.file} 2>/dev/null ; \
		rm -f ${__vm__.frame.file} ${__vm__.frame.cmd.file} 2>/dev/null ; \
	} ; \
	trap __vmframe EXIT ; \
	trap 'printf "%s" "$$BASH_COMMAND" > ${__vm__.frame.cmd.file} 2>/dev/null || :' DEBUG

## The live call stack as JSON, read by glob since an observer runs under a
## different supervisor and would not match the keyed paths.  Files whose
## process is gone are dropped, cleaning up after a missed pop; the rest sort
## by level.  Degrades to empty, and reads the null device so jq never hangs.
__vm__.frames=( live='' ; \
	for f in .tmp.cmk.vmframe.* ; do \
	  [ -e "$$f" ] || continue ; \
	  p=`printf '%s' "$$f" | sed 's/.*[.]//'` ; \
	  { [ -n "$$p" ] && kill -0 "$$p" 2>/dev/null ; } && live="$$live $$f" || rm -f "$$f" `printf '%s' "$$f" | sed s/vmframe/vmcmd/` 2>/dev/null ; \
	done ; \
  fr=`[ -n "$$live" ] && cat $$live 2>/dev/null | ${jq.run.pipe} -s -c 'sort_by(.lvl,.step)' 2>/dev/null` ; [ -n "$$fr" ] || fr='[]' ; \
  lastf=`ls .tmp.cmk.vmlast.* 2>/dev/null | head -1` ; last=`{ [ -s "$$lastf" ] && cat "$$lastf" ; } 2>/dev/null` ; [ -n "$$last" ] || last='null' ; \
  step=`cat .tmp.cmk.vmstep.* 2>/dev/null | sort -n | tail -1` ; [ -n "$$step" ] || step=0 ; \
  dp=`printf '%s' "$$fr" | ${jq.run} -r '.[-1].pid // empty' 2>/dev/null` ; cmd=`{ [ -n "$$dp" ] && head -c 240 .tmp.cmk.vmcmd.*.$$dp ; } 2>/dev/null` ; \
  printf '%s' "$$fr" | ${jq.run} -c --argjson last "$$last" --argjson step "$$step" --arg cmd "$$cmd" '{step:$$step,frames:.,last:$$last,cmd:$$cmd}' ) </dev/null
__vm__.frames:
	${__vm__.frames}

## ░░ Snapshot ░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░
## The single self-model accessor: the live machine is its own snapshot,
## emitted as one JSON object and consumed by every observer.  The chain is
## the frame goals plus the top frame's pending continuation, falling back to
## the level ledger for a flat machine.  Reads by glob, so it assumes one run
## per directory, and degrades to an empty object so it is always parseable.
__vm__=( f=`ls .tmp.CONTROL_STACK_FRAMES.* 2>/dev/null | head -1` ; \
  e=`ls .tmp.cmk.vmenv.* 2>/dev/null | head -1` ; \
  g=`ls .tmp.cmk.vmlvl.* 2>/dev/null | head -1` ; \
  [ -n "$$f$$e$$g" ] || { echo '{}' ; exit 0 ; } ; \
  fr=`{ [ -s "$$f" ] && cat "$$f" ; } 2>/dev/null` ; [ -n "$$fr" ] || fr='[]' ; \
  ev=`{ [ -s "$$e" ] && cat "$$e" ; } 2>/dev/null` ; [ -n "$$ev" ] || ev='{}' ; \
  lv=`cat .tmp.cmk.vmlvl.* 2>/dev/null | ${jq.run.pipe} -s -c 'sort_by(.lvl)' 2>/dev/null` ; [ -n "$$lv" ] || lv='[]' ; \
  printf '%s' "$$fr" | ${jq.run} -c \
    --argjson env "$$ev" \
    --argjson levels "$$lv" \
    --argjson lvl "$${MAKELEVEL:-0}" \
    --arg ip_reg "$(__ip__)" \
    --arg step_reg "$(__step__)" \
    --arg posix_reg "$(__posix_code__)" \
    --arg exit_reg "$(__exit_code__)" \
    'def chainof:(map(.goal))+((( .[-1].cont)//"")|split(" ")|map(select(length>0))); \
     def numreg(s): if (s|length)>0 then (s|tonumber? // null) else null end; \
     (chainof) as $$c \
     | { chain:((if ($$c|length)>0 then $$c else ($$levels|map(.goal)) end)|join(" ")), \
         ip:(.[-1].goal // ($$levels[-1].goal // (if ($$ip_reg|length)>0 then $$ip_reg else "" end))), \
         k:length, e:$$env, lvl:$$lvl, levels:$$levels, \
         step:numreg($$step_reg), posix_code:numreg($$posix_reg), exit_code:numreg($$exit_reg) }' ) </dev/null

# The snapshot's long-format aliases, preferred in core and demos for legibility.
__vm__.snapshot=${__vm__}
__vm__.snap=${__vm__}

## ░░ Field accessors ░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░
## The CEK cells as projections of the snapshot, each with a short canonical
## name and a long alias.  K is the saved frames, read inline from this
## process's stack; an observer uses the snapshot.  C is the innermost goal.
__vm__.stack=${control_stack.frames}
__vm__.kontinuation=${__vm__.stack}
__vm__.ip=${__vm__} | ${jq.run} -r '.ip // empty' 2>/dev/null
__vm__.instruction_pointer=${__vm__.ip}
__vm__.control=${__vm__.ip}

# The untried alternatives of the nearest choice frame, empty when none is live.
__vm__.frontier=${control_stack.frames} \
	| ${jq.run} -r 'map(select(.kind=="choice")) | last | (.alts // []) | join(" ")' 2>/dev/null

# The same frontier read by glob, so another process can inspect a live machine.
__vm__.frontier.observed=ls .tmp.CONTROL_STACK_FRAMES.* 2>/dev/null \
	| head -1 \
	| xargs -r cat 2>/dev/null \
	| ${jq.run} -r 'map(select(.kind=="choice")) | last | (.alts // []) | join(" ")' 2>/dev/null

## ░░ Minimap feeder ░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░
## A long-lived feeder rendering the live call stack and choice frontier as
## one tree per tick.  The innermost frame is active, its step rides along as
## a note, untried alternatives hang beneath it.  Any traced program gets this
## free.  It emits only on change and always emits a valid tree.
__vm__.minimap.view=($$alts | split(" ") | map(select(length>0)) | map({label:.,note:"alt"})) as $$frontier \
  | (.frames | reverse) as $$r \
  | ( reduce $$r[] as $$x (null; {label:$$x.goal, note:("·"+($$x.step|tostring)), active:(.==null), children:(if .==null then $$frontier else [.] end)}) ) as $$stack \
  | {label:"vm", children:(if $$stack==null then [] else [$$stack] end)}
__vm__.minimap:
	last='' ; \
	while true ; do \
	  fr="$$( ${__vm__.frames} )" ; \
	  alts="$$( ${__vm__.frontier.observed} )" ; \
	  line="$$( printf '%s' "$$fr" | ${jq.run} -c --arg alts "$$alts" '${__vm__.minimap.view}' 2>/dev/null )" ; \
	  { [ -n "$$line" ] && [ "$$line" != "$$last" ] ; } && { printf '%s\n' "$$line" ; last="$$line" ; } ; \
	  sleep $${CMK_MINIMAP_WAIT:-1} ; \
	done

## ░░ Observers ░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░
## Every self-model name doubles as its own display target: the macro embeds
## the value in a recipe, the target prints it from the command line.  There
## is no show suffix, because make's variable and target namespaces already
## draw that line.  These are live during a run, an empty object once idle.
__vm__:
	${__vm__}

__vm__.snapshot:
	${__vm__.snapshot}

__vm__.stack:
	${__vm__.stack}

__vm__.kontinuation:
	${__vm__.kontinuation}

__vm__.ip:
	${__vm__.ip}

__vm__.instruction_pointer:
	${__vm__.instruction_pointer}

__vm__.control:
	${__vm__.control}

__vm__.frontier:
	${__vm__.frontier}

## ░░ Interactive steering ░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░
## A steerable machine blocks waiting for a command rather than self-looping,
## which would overwrite its own mailbox every tick and race any external
## steer.  The wait side blocks until a command file appears and echoes the
## goal; the post side writes that file, a race-free channel over a jump.
__vm__.steer.cmd=.tmp.cmk.vm.steer.cmd

# Block for a steer command, bounded by a poll ceiling, then echo and clear it.
__vm__.steer.wait=i=0 ; \
	while [ ! -s ${__vm__.steer.cmd} ] ; do \
	  sleep $${VM_STEER_WAIT:-1} ; \
	  i=$$(( i + 1 )) ; \
	  [ "$$i" -lt "$${VM_STEER_MAX:-100000}" ] || { echo ; exit 0 ; } ; \
	done ; \
	cat ${__vm__.steer.cmd} ; \
	rm -f ${__vm__.steer.cmd}
# post a steer command (the goal to run next) for a waiting machine to pick up.
__vm__.steer.post=printf '%s\n' "$(strip ${1})" > ${__vm__.steer.cmd}
